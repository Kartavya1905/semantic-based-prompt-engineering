# =============================================================================
# FILE:         .env.example
# WHAT IT DOES: Template for local settings. Copy to .env and edit; .env is gitignored.
# COST:         everything here is local and free — no API keys needed.
# =============================================================================

# --- 1. Local LLM server (Ollama) ---
# Same address whether Ollama runs natively or in Docker (docker-compose.yml).
OLLAMA_BASE_URL=http://localhost:11434

# --- 2. Models ---
# Main model for experiments. qwen2.5:7b (~4.7 GB) fits an 8 GB GPU.
# Without a GPU use llama3.2:3b.
DEFAULT_MODEL_NAME=qwen2.5:7b
# Small model for the CI smoke benchmark (fast canary, not a quality judge).
CI_MODEL_NAME=qwen2.5:1.5b

# --- 3. Evaluation ---
# Local ONNX embedding model (fastembed) used to score summary similarity.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Where benchmark run logs are written.
RESULTS_DIR=evaluation/results
